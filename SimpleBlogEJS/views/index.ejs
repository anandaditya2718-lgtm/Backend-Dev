<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Simple Blog</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, sans-serif; background: #f5f7fb; margin: 0; }
        header { background: #4b6cb7; color: #fff; padding: 20px; text-align: center; }
        .container { max-width: 900px; margin: 20px auto; padding: 0 20px 40px; }
        .actions { margin: 20px 0; }
        a.button { background: #4b6cb7; color: #fff; padding: 10px 16px; border-radius: 6px; text-decoration: none; }
        .post { background: #fff; padding: 16px; border-radius: 8px; margin-bottom: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.06); }
        .post h3 { margin: 0 0 8px; }
        .post p { margin: 0; color: #555; }
        .post a { color: #4b6cb7; text-decoration: none; }
        .empty { background: #fff; padding: 20px; border-radius: 8px; text-align: center; }
    </style>
</head>
<body>
    <header>
        <h1>Simple Blog</h1>
        <p>List of posts</p>
    </header>
    <div class="container">
        <div class="actions">
            <a class="button" href="/posts/new">Create New Post</a>
        </div>

        <% if (posts.length === 0) { %>
            <div class="empty">No posts yet. Create one!</div>
        <% } else { %>
            <% posts.forEach(post => { %>
                <div class="post">
                    <h3><a href="/posts/<%= post.id %>"><%= post.title %></a></h3>
                    <p><%= post.content.length > 120 ? post.content.slice(0, 120) + '...' : post.content %></p>
                </div>
            <% }) %>
        <% } %>
    </div>
</body>
</html>
