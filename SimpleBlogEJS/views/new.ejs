<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Post</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, sans-serif; background: #f5f7fb; margin: 0; }
        header { background: #4b6cb7; color: #fff; padding: 20px; text-align: center; }
        .container { max-width: 700px; margin: 20px auto; padding: 0 20px 40px; }
        form { background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.06); }
        label { display: block; margin: 10px 0 6px; font-weight: 600; }
        input, textarea { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; }
        textarea { min-height: 160px; resize: vertical; }
        .error { background: #fee; color: #c33; padding: 10px; border-radius: 6px; margin-bottom: 12px; }
        .actions { margin-top: 14px; display: flex; gap: 10px; }
        button, a.button { padding: 10px 16px; border-radius: 6px; border: none; text-decoration: none; }
        button { background: #4b6cb7; color: #fff; cursor: pointer; }
        a.button { background: #eee; color: #333; }
    </style>
</head>
<body>
    <header>
        <h1>Create New Post</h1>
    </header>
    <div class="container">
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <form action="/posts" method="POST">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" value="<%= values.title %>" required />

            <label for="content">Content</label>
            <textarea id="content" name="content" required><%= values.content %></textarea>

            <div class="actions">
                <button type="submit">Publish</button>
                <a class="button" href="/posts">Cancel</a>
            </div>
        </form>
    </div>
</body>
</html>
